{
  "$schema": "https://opencode.ai/config.json",
  "model": "localllms/qwen3.8-flash-next",
  "provider": {
    "localllms": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLMs",
      "options": {
        "baseURL": "http://gpu05:7547/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash-Next (local)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@v1.0.3#subdirectory=mcp",
        "blender-mcp"
      ],
      "enabled": true
    }
  }
}
