{
  "$schema": "https://opencode.ai/config.json",
  "model": "localllms/qwen3.8-flash-next",
  "providers": {
    "localllms": {
      "name": "Local LLMs",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://gpu05:7547/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash-Next (local)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "blender": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://projects.blender.org/lab/blender_mcp.git@v1.0.3#subdirectory=mcp",
          "blender-mcp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      }
    }
  }
}
